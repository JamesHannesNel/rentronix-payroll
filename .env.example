# Copy to .env on the server (scripts/setup-ubuntu.sh does this and fills in
# the random values). .env is never committed to GitHub.

# --- Django ---
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me
# The VM's address(es), comma separated. Hyper-V's Default Switch can give
# the VM a new IP after a reboot; add the new one here if that happens.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_COOKIES=false
APP_PORT=8000

# --- Database ---
POSTGRES_PASSWORD=change-me

# --- PaySpace ---
# mock = built-in fake data (no credentials needed)
# staging = PaySpace test system; production = live
PAYSPACE_ENV=mock
PAYSPACE_CLIENT_ID=
PAYSPACE_CLIENT_SECRET=
PAYSPACE_SCOPE=api.read_only

# --- Integration API ---
API_RATE_LIMIT=60/min
